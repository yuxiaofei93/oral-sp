[Unit]
Description=Oral SP Django API served by Gunicorn
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/oral-sp/apps/api
EnvironmentFile=/opt/oral-sp/.env.production
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/oral-sp/.venv/bin/gunicorn --config /opt/oral-sp/deploy/gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
KillSignal=SIGQUIT
TimeoutStartSec=60
TimeoutStopSec=60
UMask=0027
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/oral-sp/var
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
