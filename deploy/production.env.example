DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=wenzhen.wishine.top,manage.wishine.top,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://wenzhen.wishine.top,https://manage.wishine.top
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=300
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DATABASE_URL=sqlite:////opt/oral-sp/var/production.sqlite3
SQLITE_TIMEOUT_SECONDS=20
MEDIA_ROOT=/opt/oral-sp/var/private-media

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-deepseek-api-key
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=465
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL="口腔模拟问诊系统 <replace-with-sender-address>"
