# Local development values. Production uses deploy/production.env.example.
# SQLite defaults to apps/api/var/db.sqlite3 when DATABASE_URL is omitted.
# To use another file, provide an absolute URL such as:
# DATABASE_URL=sqlite:////absolute/path/to/oral-sp.sqlite3
SQLITE_TIMEOUT_SECONDS=20

DJANGO_SECRET_KEY=replace-this-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
DJANGO_SECURE_COOKIES=false

# Files are private local media in the MVP. S3 is intentionally not required.
# MEDIA_ROOT defaults to apps/api/var/private-media.

# Keep mock for deterministic local development. To use DeepSeek, set
# LLM_PROVIDER=deepseek and put the API key in the server-side .env only.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# Local default prints verification emails in the API terminal. Replace with
# django.core.mail.backends.smtp.EmailBackend and SMTP values when deployed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL="口腔模拟问诊系统 <no-reply@example.com>"
