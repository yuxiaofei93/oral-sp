# Development-only values. Replace every secret before a real deployment.
POSTGRES_DB=oral_sp
POSTGRES_USER=oral_sp
POSTGRES_PASSWORD=oral_sp_dev_only
DATABASE_URL=postgresql://oral_sp:oral_sp_dev_only@db:5432/oral_sp

DJANGO_SECRET_KEY=replace-this-before-deployment
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_COOKIES=false
WEB_CONCURRENCY=1

# Files are private local media in the MVP. S3 is intentionally not required.
MEDIA_ROOT=/app/var/private-media

# Keep mock for deterministic local development. To use DeepSeek, set
# LLM_PROVIDER=deepseek and put the API key in the server-side .env only.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# Local default prints verification emails in the API terminal. Replace with
# django.core.mail.backends.smtp.EmailBackend and SMTP values when deployed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=口腔模拟问诊系统 <no-reply@example.com>
